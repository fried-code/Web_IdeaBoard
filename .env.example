# Neon Serverless PostgreSQL Connection String (Port 443 HTTP or Pooler)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional Neon HTTP endpoint override (auto-derived if omitted)
# NEON_SQL_ENDPOINT=https://api.c-6.us-east-2.aws.neon.tech/sql

# Flask Secret Key for Session Authentication
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Server Port (optional, defaults to 5000)
PORT=5000
